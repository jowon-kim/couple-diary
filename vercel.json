{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "installCommand": "npm install --omit=dev",
  "functions": {
    "api/**/*.js": { "includeFiles": "schema.sql" }
  },
  "headers": [
    {
      "source": "/api/:path((?!photos/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
